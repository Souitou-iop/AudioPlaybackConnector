msgid "Unsupported Operating System"
msgstr "不支持的操作系统"

msgid "AudioPlaybackConnector is not supported on this operating system version."
msgstr "此操作系统版本不支持 AudioPlaybackConnector。"

msgid "AudioPlaybackConnector"
msgstr "音频播放连接器"

msgid "Bluetooth Audio Devices"
msgstr "蓝牙音频设备"

msgid "No Bluetooth audio devices found."
msgstr "未找到已配对的蓝牙音频设备。"

msgid "Connect"
msgstr "连接"

msgid "Disconnect"
msgstr "断开"

msgid "Disconnect all"
msgstr "全部断开"

msgid "Mute"
msgstr "静音"

msgid "Unmute"
msgstr "取消静音"

msgid "Volume"
msgstr "音量"

msgid "Refresh"
msgstr "刷新"

msgid "Full"
msgstr "已满载"

msgid "Hardware limit reached (Max 2 devices). Please disconnect one first."
msgstr "已达蓝牙硬件并发上限 (最多2台)，请先断开一台设备"

msgid "Exit"
msgstr "退出"

msgid "Bluetooth Settings"
msgstr "蓝牙设置"

msgid "Sound Settings"
msgstr "声音设置"

